 #include <rex/system/xmemory.h>
 
 namespace {
@@ -32,8 +33,65 @@ rex::memory::Memory& GetTestMemory() {
 
 void DummyFn(PPCContext&, uint8_t*) {}
 
+void ClobberCallback(PPCContext& ctx, uint8_t*) {
+  ctx.r3.u64 = 0xCAFEBABE;
+  ctx.r14.u64 = 0;
+  ctx.r31.u64 = 0;
+  ctx.f14.u64 = 0;
+  ctx.f31.u64 = 0;
+  ctx.v14.u64[0] = 0;
+  ctx.v31.u64[1] = 0;
+  ctx.v64.u64[0] = 0;
+  ctx.v127.u64[1] = 0;
+  ctx.cr2.set_raw(0);
+  ctx.cr3.set_raw(0);
+  ctx.cr4.set_raw(0);
+}
+
 }  // namespace
 
+TEST_CASE("FunctionDispatcher: Execute preserves guest nonvolatile registers",
+          "[runtime][dispatcher]") {
+  auto& memory = GetTestMemory();
+  rex::runtime::ExportResolver resolver;
+  rex::runtime::FunctionDispatcher dispatcher(&memory, &resolver);
+
+  constexpr uint32_t kModuleBase = 0x89000000u;
+  constexpr uint32_t kCallbackAddress = kModuleBase + 0x100;
+  REQUIRE(dispatcher.InitializeFunctionTable(kModuleBase, 0x10000, kModuleBase, 0x100000));
+  REQUIRE(dispatcher.SetFunction(kCallbackAddress, &ClobberCallback));
+
+  rex::runtime::ThreadState thread_state(1, 0x70010000, 0, &memory);
+  auto* ctx = thread_state.context();
+  ctx->lr = 0x82001234;
+  ctx->r14.u64 = 0x14;
+  ctx->r31.u64 = 0x31;
+  ctx->f14.u64 = 0xF14;
+  ctx->f31.u64 = 0xF31;
+  ctx->v14.u64[0] = 0x14;
+  ctx->v31.u64[1] = 0x31;
+  ctx->v64.u64[0] = 0x64;
+  ctx->v127.u64[1] = 0x127;
+  ctx->cr2.set_raw(0x2);
+  ctx->cr3.set_raw(0x3);
+  ctx->cr4.set_raw(0x4);
+
+  CHECK(dispatcher.Execute(&thread_state, kCallbackAddress, nullptr, 0) == 0xCAFEBABE);
+  CHECK(ctx->lr == 0x82001234);
+  CHECK(ctx->r1.u64 == 0x70010000);
+  CHECK(ctx->r14.u64 == 0x14);
+  CHECK(ctx->r31.u64 == 0x31);
+  CHECK(ctx->f14.u64 == 0xF14);
+  CHECK(ctx->f31.u64 == 0xF31);
+  CHECK(ctx->v14.u64[0] == 0x14);
+  CHECK(ctx->v31.u64[1] == 0x31);
+  CHECK(ctx->v64.u64[0] == 0x64);
+  CHECK(ctx->v127.u64[1] == 0x127);
+  CHECK(ctx->cr2.raw() == 0x2);
+  CHECK(ctx->cr3.raw() == 0x3);
+  CHECK(ctx->cr4.raw() == 0x4);
+}
