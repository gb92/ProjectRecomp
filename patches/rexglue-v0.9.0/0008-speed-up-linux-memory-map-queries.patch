-// Parse a line from /proc/self/maps into a LinuxMapEntry
+static bool ParseHexAddress(const char*& cursor, uintptr_t& value) {
+  value = 0;
+  bool parsed_digit = false;
+  while (true) {
+    const char c = *cursor;
+    uint8_t digit;
+    if (c >= '0' && c <= '9') {
+      digit = static_cast<uint8_t>(c - '0');
+    } else if (c >= 'a' && c <= 'f') {
+      digit = static_cast<uint8_t>(c - 'a' + 10);
+    } else if (c >= 'A' && c <= 'F') {
+      digit = static_cast<uint8_t>(c - 'A' + 10);
+    } else {
+      break;
+    }
+    parsed_digit = true;
+    value = (value << 4) | digit;
+    ++cursor;
+  }
+  return parsed_digit;
+}
