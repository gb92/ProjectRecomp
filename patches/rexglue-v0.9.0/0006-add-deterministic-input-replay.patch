+bool SDLInputDriver::LoadReplay() {
+  const char* replay_path = std::getenv("REXGLUE_INPUT_REPLAY");
+  if (!replay_path || !replay_path[0]) {
+    return true;
+  }
+
+  std::ifstream stream(replay_path);
+  if (!stream) {
+    REXLOG_ERROR("SDL input replay: failed to open '{}'", replay_path);
+    return false;
+  }
+
+  ReplayEvent event;
+  while (stream >> event.timestamp_ns >> event.type >> event.code >> event.value) {
+    replay_events_.push_back(event);
+  }
+  if (!stream.eof() || replay_events_.empty()) {
+    REXLOG_ERROR("SDL input replay: invalid or empty trace '{}'", replay_path);
+    replay_events_.clear();
+    return false;
+  }
+
+  replay_start_time_ = std::chrono::steady_clock::now();
+  REXLOG_INFO("SDL input replay: loaded {} events from '{}'", replay_events_.size(),
+              replay_path);
+  return true;
+}
+
+void SDLInputDriver::UpdateReplay() {
+  const uint64_t elapsed_ns = static_cast<uint64_t>(
+      std::chrono::duration_cast<std::chrono::nanoseconds>(
+          std::chrono::steady_clock::now() - replay_start_time_)
+          .count());
+  bool changed = false;
+  while (replay_event_index_ < replay_events_.size() &&
+         replay_events_[replay_event_index_].timestamp_ns <= elapsed_ns) {
+    const ReplayEvent& event = replay_events_[replay_event_index_++];
+    if (event.type != 0) {
+      ApplyReplayEvent(event);
+      changed = true;
+    }
+  }
+  if (changed) {
+    replay_state_.packet_number =
+        static_cast<uint32_t>(replay_state_.packet_number) + 1;
+  }
+}
+
+void SDLInputDriver::ApplyReplayEvent(const ReplayEvent& event) {
+  X_INPUT_GAMEPAD& gamepad = replay_state_.gamepad;
+  if (event.type == 1) {
+    uint16_t button = 0;
+    switch (event.code) {
+      case 304:
+        button = X_INPUT_GAMEPAD_A;
+        break;
+      case 305:
+        button = X_INPUT_GAMEPAD_B;
+        break;
+      case 307:
+        button = X_INPUT_GAMEPAD_X;
+        break;
+      case 308:
+        button = X_INPUT_GAMEPAD_Y;
+        break;
+      case 310:
+        button = X_INPUT_GAMEPAD_LEFT_SHOULDER;
+        break;
+      case 311:
+        button = X_INPUT_GAMEPAD_RIGHT_SHOULDER;
+        break;
+      case 314:
+        button = X_INPUT_GAMEPAD_BACK;
+        break;
+      case 315:
+        button = X_INPUT_GAMEPAD_START;
+        break;
+      case 316:
+        button = X_INPUT_GAMEPAD_GUIDE;
+        break;
+      case 317:
+        button = X_INPUT_GAMEPAD_LEFT_THUMB;
+        break;
+      case 318:
+        button = X_INPUT_GAMEPAD_RIGHT_THUMB;
+        break;
+      default:
+        return;
+    }
+    uint16_t buttons = gamepad.buttons;
+    gamepad.buttons = event.value ? buttons | button : buttons & ~button;
+    return;
+  }
+
+  if (event.type != 3) {
+    return;
+  }
+  switch (event.code) {
+    case 0:
+      gamepad.thumb_lx = static_cast<int16_t>(event.value);
+      break;
+    case 1:
+      gamepad.thumb_ly = static_cast<int16_t>(~event.value);
+      break;
+    case 2:
+      gamepad.left_trigger = static_cast<uint8_t>(std::clamp(event.value, 0, 255));
+      break;
+    case 3:
+      gamepad.thumb_rx = static_cast<int16_t>(event.value);
+      break;
+    case 4:
+      gamepad.thumb_ry = static_cast<int16_t>(~event.value);
+      break;
+    case 5:
+      gamepad.right_trigger = static_cast<uint8_t>(std::clamp(event.value, 0, 255));
+      break;
+    case 16: {
+      uint16_t buttons = gamepad.buttons;
+      buttons &= ~(X_INPUT_GAMEPAD_DPAD_LEFT | X_INPUT_GAMEPAD_DPAD_RIGHT);
+      if (event.value < 0) {
+        buttons |= X_INPUT_GAMEPAD_DPAD_LEFT;
+      } else if (event.value > 0) {
+        buttons |= X_INPUT_GAMEPAD_DPAD_RIGHT;
+      }
+      gamepad.buttons = buttons;
+      break;
+    }
+    case 17: {
+      uint16_t buttons = gamepad.buttons;
+      buttons &= ~(X_INPUT_GAMEPAD_DPAD_UP | X_INPUT_GAMEPAD_DPAD_DOWN);
+      if (event.value < 0) {
+        buttons |= X_INPUT_GAMEPAD_DPAD_UP;
+      } else if (event.value > 0) {
+        buttons |= X_INPUT_GAMEPAD_DPAD_DOWN;
+      }
+      gamepad.buttons = buttons;
+      break;
+    }
+  }
+}
